{
  "name": "@stationsure/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "StationSûre — application station (Expo, Android en priorité)",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo run:android --device",
    "ios": "expo run:ios --device",
