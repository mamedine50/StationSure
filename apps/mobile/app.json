{
  "expo": {
    "name": "StationSûre",
    "slug": "stationsure",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "stationsure",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E1311",
    "newArchEnabled": true,
    "android": {
      "package": "sn.stationsure.app",
      "adaptiveIcon": {
        "backgroundColor": "#0E1311",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "bundleIdentifier": "sn.stationsure.app",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E1311",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
