{
  "expo": {
    "name": "StationSûre",
    "slug": "stationsure",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "stationsure",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E1311",
    "newArchEnabled": true,
    "android": {
      "package": "sn.stationsure.app",
      "adaptiveIcon": {
        "backgroundColor": "#0E1311",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "sn.stationsure.app",
      "supportsTablet": true,
      "appleTeamId": "JAKZ3WL4XK"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E1311",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "StationSûre utilise la caméra uniquement pour scanner le QR de jumelage."
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "StationSûre enregistre la position au moment de chaque photo de preuve."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
