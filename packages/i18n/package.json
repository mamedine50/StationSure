  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@stationsure/config": "workspace:*",
    "@types/react": "19.2.4",
    "eslint": "9.39.5",
    "react": "19.2.3",
    "typescript": "5.9.3"
  }
}
