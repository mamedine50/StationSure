# StationSûre — supabase/
# Copier en supabase/.env (jamais versionné). Aucune valeur secrète ici.
# Variables lues par `supabase functions serve --env-file supabase/.env` et par `supabase link`.
SUPABASE_PROJECT_ID=
SUPABASE_ACCESS_TOKEN=
# Pour les phases suivantes (rapport WhatsApp, SMS) :
WHATSAPP_API_TOKEN=

# Pile locale (supabase start) : API 54721, Postgres 54722, Studio 54723, Inbucket 54724.
LOCAL_DB_URL=postgresql://postgres:postgres@127.0.0.1:54722/postgres
