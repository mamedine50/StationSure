# StationSûre — supabase/functions/.env (jamais versionné) : variables des Edge Functions en local.
# Chargé par `pnpm db:functions:serve` (supabase functions serve --env-file supabase/functions/.env).
# SUPABASE_URL, SUPABASE_ANON_KEY et SUPABASE_SERVICE_ROLE_KEY sont injectées automatiquement en local.

# Adaptateur d'envoi : dev (défaut, aucun envoi, messages visibles sur /dev/messages) | meta (WhatsApp réel)
NOTIFIER=dev
# Secret partagé entre pg_cron (private.notify_config.worker_secret) et notify-worker.
NOTIFY_WORKER_SECRET=dev-notify-secret
# Adresse du site pour les liens des courriels d'invitation.
SITE_URL=http://localhost:3000

# WhatsApp Business Platform (Meta) — voir docs/whatsapp-modeles.md. Laisser vide en local.
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_API_VERSION=v22.0
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# SMS de secours (passerelle HTTP générique). Laisser vide pour désactiver.
SMS_API_URL=
SMS_API_TOKEN=
SMS_SENDER=StationSure
